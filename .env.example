# ============ 秋招作战台 v2 环境配置 ============
# 复制为 .env 后按需修改（当前版本直接读取系统环境变量，示例见下）

# 服务端口
PORT=3000

# JWT 密钥（不设置则自动生成并持久化到 data/.secret）
# JWT_SECRET=please-change-me

# ---- AI 能力（可选）----
# 配置 AI_API_KEY 后，各模块将调用真实大语言模型 API（文本生成 + 视觉理解）；
# 不配置则使用内置演示引擎（规则 + 模板），全流程仍可跑通，页面会标注当前模式。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# 图片 OCR 使用的视觉模型（默认跟随 AI_MODEL）
AI_VISION_MODEL=gpt-4o-mini
